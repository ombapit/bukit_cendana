# Performance optimizations
# Enable offline mode if node_modules is already cached
# audit=false
# fund=false

# Use pnpm if available (much faster than npm)
# shamefully-hoist=true

# Reduce fetch timeout for faster failures
fetch-timeout=20000
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000

# Prefer offline modules
offline=false

# Reduce log output during install
loglevel=warn
