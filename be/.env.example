# Application
APP_PORT=8080
APP_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=api247
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_HOURS=168

# iPaymu Payment Gateway
IPAYMU_VA=your_va_number
IPAYMU_API_KEY=your_api_key
IPAYMU_BASE_URL=https://sandbox.ipaymu.com
IPAYMU_NOTIFY_URL=https://your-backend.com/api/v1/webhooks/ipaymu
IPAYMU_RETURN_URL=https://your-backend.com/api/v1/ipl-payments/return
IPAYMU_CANCEL_URL=https://your-backend.com/api/v1/ipl-payments/cancel
